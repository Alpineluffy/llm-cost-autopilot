# LLM Cost AutoPilot - Environment Variables
# Copy this to .env and fill in your values

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434

# Database
DATABASE_URL=sqlite:///./data/autopilot.db

# API authentication
# Required whenever MOCK_PROVIDERS=false: the service spends money on your
# behalf, and one request can fan out to three model calls. The API refuses
# to start with live providers and no key set.
AUTOPILOT_API_KEY=

# App Settings
# true  = simulated responses, no keys needed, no spend
# false = real provider calls; a missing or placeholder key now RAISES
#         rather than silently returning fabricated answers
MOCK_PROVIDERS=true
LOG_LEVEL=INFO
VERIFICATION_ENABLED=true
VERIFICATION_SAMPLE_RATE=0.3
